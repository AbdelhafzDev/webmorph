{
  "name": "webmorph",
  "version": "0.1.0",
  "description": "Turn any website into validated tools and skills for AI agents: evidence-first discovery, API-first tool generation, replay validation, MCP.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "webmorph": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schemas:export": "tsx src/cli.ts schemas export schemas",
    "diagrams": "node scripts/diagrams/render.mjs",
    "bench": "node --import tsx scripts/bench/run.mts",
    "bench:compare": "node --import tsx scripts/bench/compare.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.11.2",
    "openai": "^7.39.0",
    "playwright": "^1.64.1",
    "robots-parser": "^3.0.1",
    "undici": "^8.12.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
