      "isDeleted": false,
      "boundElements": [],
      "updated": 1792655097398,
      "link": null,
      "locked": false,
      "text": "What never happens: a redirect or link to another host is followed (it is recorded as out of scope); a bot challenge or\nrate limit is evaded (it is recorded as blocked); a probe or tool sends a POST (writes need an explicit flag, and even then\nonly search or filter forms without sensitive fields); a credential WebMorph observed is replayed on its own authority (D21, D23).",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "PKSQZh8YqIyVaSI0RNnG6",
      "originalText": "What never happens: a redirect or link to another host is followed (it is recorded as out of scope); a bot challenge or\nrate limit is evaded (it is recorded as blocked); a probe or tool sends a POST (writes need an explicit flag, and even then\nonly search or filter forms without sensitive fields); a credential WebMorph observed is replayed on its own authority (D21, D23).",
      "autoResize": true,
      "lineHeight": 1.25
    },
