    {
      "id": "WE5Q8bqhyk1Cf7-Uga5T4",
      "type": "text",
      "x": 45,
      "y": 590.625,
      "width": 675.8984375,
      "height": 48.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
