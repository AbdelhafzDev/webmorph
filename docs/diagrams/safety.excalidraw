      "boundElements": [],
      "updated": 1792658470105,
      "link": null,
      "locked": false,
      "text": "Route layer (per request)\ndocument scope, method policy (GET only\nunless write probes), images, media and\nfonts skipped, fetch with redirects\ndisabled, every hop re-checked,\nWebSockets refused",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "route",
      "originalText": "Route layer (per request)\ndocument scope, method policy (GET only\nunless write probes), images, media and\nfonts skipped, fetch with redirects\ndisabled, every hop re-checked,\nWebSockets refused",
      "autoResize": true,
      "lineHeight": 1.25
