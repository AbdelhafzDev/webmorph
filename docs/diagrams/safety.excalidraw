      "boundElements": [],
      "updated": 0,
      "link": null,
      "locked": false,
      "text": "SafeHttpClient\nper hop: exact-host scope, prohibited\npaths, blocked hostnames, size cap,\ntimeout, bounded retries honoring\nRetry-After, per-host delay,\nconcurrency and request budget",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "safety-4",
      "originalText": "SafeHttpClient\nper hop: exact-host scope, prohibited\npaths, blocked hostnames, size cap,\ntimeout, bounded retries honoring\nRetry-After, per-host delay,\nconcurrency and request budget",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "safety-20",
      "type": "text",
