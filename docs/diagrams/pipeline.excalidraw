      "link": null,
      "locked": false,
      "text": "Every artifact is immutable per job and carries an envelope: schema version, site and job IDs, producing stage,\nsource artifacts, provenance. Stages talk only through artifacts, so a job can be inspected, resumed and diffed.",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "G9lmbBxUlgptHQrvg0QCy",
