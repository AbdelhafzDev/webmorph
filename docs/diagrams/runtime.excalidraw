      "versionNonce": 1761234854,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792655097533,
      "link": null,
      "locked": false,
      "text": "Results carry a run record: per-step status, the extracted output validated\nagainst the output schema, the final URL. Failures carry a code an agent can\nact on. After two consecutive site-change failures a tool is degraded and\nrefused with TOOL_UNAVAILABLE until an operator revalidates it; agents\nnever retry blindly against a changed site.",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "CJJl6POa6mp9dQgnLYX5K",
      "originalText": "Results carry a run record: per-step status, the extracted output validated\nagainst the output schema, the final URL. Failures carry a code an agent can\nact on. After two consecutive site-change failures a tool is degraded and\nrefused with TOOL_UNAVAILABLE until an operator revalidates it; agents\nnever retry blindly against a changed site.",
      "autoResize": true,
      "lineHeight": 1.25
    }
